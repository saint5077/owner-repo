# Nora Immobilien — Beispiel-Konfiguration. Kopieren nach .env.local (lokal) bzw. als
# Umgebungsvariablen in Vercel setzen (Produktion/Demo). Nie echte Werte hier eintragen.

# --- Datenbank ---
# Produktion/Demo: Neon Postgres (Region Frankfurt), z. B. postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/nora?sslmode=require
# Lokale Entwicklung: lokaler Postgres-Server, siehe DECISIONS.md "Lokale Entwicklung"
DATABASE_URL=postgres://nora:CHANGE_ME@127.0.0.1:5432/nora_dev

# Payload CMS Secret (beliebiger langer Zufallsstring, z. B. `openssl rand -hex 32`)
PAYLOAD_SECRET=CHANGE_ME

# --- Medien-Speicher ---
# Produktion/Demo: Vercel Blob (EU-Region, falls wählbar). In lokaler Entwicklung ungesetzt lassen —
# Payload speichert Uploads dann lokal unter /media (siehe DECISIONS.md).
BLOB_READ_WRITE_TOKEN=

# --- E-Mail (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=info@nora-immobilien.ch
# Demo-Modus: ALLE E-Mails gehen nur hierhin, nie an echte Empfänger. Siehe Briefing §13.
DEMO_RECIPIENT=

# --- Demo- vs. Live-Modus ---
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Spam-Schutz (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate Limiting (Upstash Redis) ---
# Leer lassen in der Entwicklung — fällt automatisch auf einen In-Memory-Ratelimiter zurück.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron (Vercel Cron Secret) ---
CRON_SECRET=

# --- Erster Admin-Benutzer (nur für `pnpm seed`) ---
SEED_ADMIN_EMAIL=admin@nora-immobilien.ch
SEED_ADMIN_PASSWORD=CHANGE_ME

# --- Google Search Console Verifizierung ---
# NUR im Live-Modus einbauen (bestehendes Token aus der alten Seite, siehe Briefing §1).
GOOGLE_SITE_VERIFICATION=
