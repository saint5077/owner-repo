{
  "name": "nora-immobilien",
  "version": "0.1.0",
  "private": true,
  "description": "Nora Immobilien AG — Website und Backend (Konzept-Vorschau fuer Axion)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" NODE_USE_ENV_PROXY=1 next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation NODE_USE_ENV_PROXY=1 next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation NODE_USE_ENV_PROXY=1 next dev",
    "typecheck": "tsc --noEmit",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation NODE_USE_ENV_PROXY=1 tsx --env-file=.env.local src/seed/index.ts",
    "seed:en": "cross-env NODE_OPTIONS=--no-deprecation NODE_USE_ENV_PROXY=1 tsx --env-file=.env.local scripts/seed-en.ts",
    "verify:access-control": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env.local scripts/verify-access-control.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation NODE_USE_ENV_PROXY=1 next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/translations": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.8.1",
    "maplibre-gl": "^6.17.0",
    "next": "16.3.3",
    "payload": "3.93.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.91.0",
    "resend": "^6.37.0",
    "sharp": "0.35.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@next/eslint-plugin-next": "16.3.3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "lighthouse": "^13.6.0",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.16",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
